"""Base64 credential store.

Stores credentials under the state dir (default ~/.gdaa, override with GSDB_HOME
or legacy GDAA_HOME) as Base64-encoded text files:

    credentials/<name>.enc    base64(secret)

The GSDB_PASSWORD environment variable (or legacy GDAA_PASSWORD), when set,
overrides stored credentials (CI / one-off usage).
"""
from __future__ import annotations

import base64
import os

#from .config import _NAME_RE, ensure_dir, state_dir
try:
    from .config import _NAME_RE, ensure_dir, state_dir
except ImportError:
    from config import _NAME_RE, ensure_dir, state_dir


class CredentialError(Exception):
    """Raised on missing/corrupted credentials or invalid names."""


def load_secret(name: str) -> str:
    """Return the decoded credential for a connection name."""
    if not name or not _NAME_RE.match(name):
        raise CredentialError(f"invalid credential name {name!r}")

    env = os.environ.get("GSDB_PASSWORD") or os.environ.get("GDAA_PASSWORD")
    if env:
        return env

    path = state_dir() / "credentials" / f"{name}.enc"
    try:
        encoded = path.read_text(encoding="utf-8").strip()
    except FileNotFoundError as exc:
        raise CredentialError(
            f"no stored credential for {name!r}: run `connect add {name} ...` first"
        ) from exc

    if not encoded:
        raise CredentialError(f"credential {path}: empty")

    try:
        return base64.b64decode(encoded.encode("utf-8"), validate=True).decode("utf-8")
    except Exception as exc:
        raise CredentialError(f"decode credential {path}: {exc}") from exc


def save_secret(name: str, secret: str) -> None:
    """Encode and store a credential (used by the connect skill)."""
    if not name or not _NAME_RE.match(name):
        raise CredentialError(f"invalid credential name {name!r}")

    cred_dir = ensure_dir() / "credentials"
    cred_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    path = cred_dir / f"{name}.enc"
    encoded = base64.b64encode(secret.encode("utf-8")).decode("utf-8")
    path.write_text(encoded, encoding="utf-8")
    os.chmod(path, 0o600)
